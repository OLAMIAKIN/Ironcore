# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ---- Database ------------------------------------------------------------
# Atlas connection string. Keep the real one in .env, which is git-ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ironcore

# ---- Auth ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# false for http://localhost; true anywhere with HTTPS.
COOKIE_SECURE=false
# The path the browser reaches the API under. The frontend proxies it at /api
# (see GYMFRONTEND/next.config.ts), and the refresh cookie has to be scoped to
# that path or the browser will not send it back. Leave empty only if the
# browser calls the API's own origin directly.
COOKIE_PATH_PREFIX=/api

# ---- Money ---------------------------------------------------------------
PLATFORM_FEE_RATE=0.05

# ---- Payments ------------------------------------------------------------
# mock = simulated gateway, no keys needed. paystack = real test/live keys.
PAYMENTS_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_CALLBACK_URL=http://localhost:3000/payments/callback
